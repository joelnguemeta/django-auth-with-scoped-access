  },
  "nodes": [
    {"id": "north", "level": "REGIONAL"},
    {"id": "hosp-1", "level": "FACILITY", "parent": "north"},
    {"id": "hosp-2", "level": "FACILITY", "parent": "north"},
    {"id": "dept-urg", "level": "DEPARTMENT", "parent": "hosp-1"}
  ],
  "roles": [
    {"id": "fac-admin", "permissions": ["roles.manage_roles", "patients.view_patient"], "owner": null},
    {"id": "inspector", "permissions": ["facilities.view_facility"], "owner": null},
