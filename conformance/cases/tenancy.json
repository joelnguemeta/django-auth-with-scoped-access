{
  "description": "Role ownership / multi-tenancy (SPEC §6): custom role visibility (R1), assignability restricted to the owner's subtree (R2), anti-escalation on grantable permissions (R5).",
  "config": {
    "hierarchy": ["NATIONAL", "REGIONAL", "FACILITY", "DEPARTMENT"],
    "root_level": "NATIONAL",
    "role_owner_levels": ["FACILITY"],
